<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hhros2_behavior</name>
  <version>0.1.0</version>
  <description>
    Business-decision placeholder (03_intelligence): a lightweight task state
    machine standing in for the production BehaviorTree.CPP tree and the VLM/LLM
    embodied interface. Exercises the real L3->L2/L1 contracts (SetControlMode
    service, SetGait action and cmd_vel) and reports a heartbeat to hhros2_core.
  </description>
  <maintainer email="robotics@example.com">robot_platform maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>hhros2_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
