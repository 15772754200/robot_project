<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hhros2_perception</name>
  <version>0.1.0</version>
  <description>
    Perception / planning placeholder (03_intelligence): a lightweight skeleton
    for 3D vision, point-cloud processing and local occupancy-grid generation
    that feeds Nav2. Provides the interface surface and a heartbeat now; the
    SLAM/Nav2 pipeline is filled in later.
  </description>
  <maintainer email="robotics@example.com">robot_platform maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>hhros2_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
