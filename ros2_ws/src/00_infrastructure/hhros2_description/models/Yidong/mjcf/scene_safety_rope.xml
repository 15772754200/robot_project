<mujoco model="Yidong scene with following safety rope">
    <include file="Yidong_4_29.xml"/>

    <statistic center="0 0 0.9" extent="1.8"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="160" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
        <!-- The engine keeps this independent trolley above the harness in X/Y. -->
        <body name="safety_trolley" mocap="true" pos="0 0 2.0">
            <geom name="safety_trolley" type="box" size="0.08 0.06 0.025"
                  contype="0" conaffinity="0" rgba="0.95 0.55 0.1 1"/>
            <site name="safety_rope_hook" pos="0 0 -0.025" size="0.018"
                  rgba="1 0.75 0.1 1"/>
        </body>

        <!--
          Collision-free display segments. The state viewer places these on a
          smooth curve whose arc length matches the paid-out rope length. The
          physical tendon below remains the sole source of fall-arrest force.
        -->
        <body name="safety_rope_visual_00" mocap="true" pos="0 0 1.9">
            <geom name="safety_rope_visual_geom_00" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_01" mocap="true" pos="0 0 1.8">
            <geom name="safety_rope_visual_geom_01" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_02" mocap="true" pos="0 0 1.7">
            <geom name="safety_rope_visual_geom_02" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_03" mocap="true" pos="0 0 1.6">
            <geom name="safety_rope_visual_geom_03" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_04" mocap="true" pos="0 0 1.5">
            <geom name="safety_rope_visual_geom_04" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_05" mocap="true" pos="0 0 1.4">
            <geom name="safety_rope_visual_geom_05" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_06" mocap="true" pos="0 0 1.3">
            <geom name="safety_rope_visual_geom_06" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_07" mocap="true" pos="0 0 1.2">
            <geom name="safety_rope_visual_geom_07" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_08" mocap="true" pos="0 0 1.1">
            <geom name="safety_rope_visual_geom_08" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_09" mocap="true" pos="0 0 1.0">
            <geom name="safety_rope_visual_geom_09" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_10" mocap="true" pos="0 0 0.9">
            <geom name="safety_rope_visual_geom_10" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
        <body name="safety_rope_visual_11" mocap="true" pos="0 0 0.8">
            <geom name="safety_rope_visual_geom_11" type="capsule" size="0.006 0.04"
                  contype="0" conaffinity="0" rgba="1 0.75 0.1 1"/>
        </body>
    </worldbody>

    <!--
      The line is slack in normal standing and becomes load-bearing only after
      the torso descends. The hard upper range remains the final fall arrestor.
    -->
    <tendon>
        <spatial name="safety_rope" limited="true" range="0 1.02"
                 springlength="0 0.92" stiffness="8000" damping="6"
                 solreflimit="0.03 1" width="0.001" rgba="1 0.75 0.1 0">
            <site site="safety_rope_hook"/>
            <site site="safety_harness"/>
        </spatial>
    </tendon>
</mujoco>
