<mujoco model="YD scene">
    <include file="Yidong_4_29.xml"/>

    <statistic center="0 0 0.65" extent="1.3"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="160" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="51" height="30"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
        <material name="stairs" rgba="0.5 0.5 0.5 1" reflectance="0.1"/>
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
        
        <!-- 上楼梯部分 - 间距缩小为0.3米 -->
        <geom name="step1" type="box" size="0.5 3 0.04" pos="0.9 0 0.08" material="stairs"/>
        <geom name="step2" type="box" size="0.5 3 0.08" pos="1.2 0 0.16" material="stairs"/>
        <geom name="step3" type="box" size="0.5 3 0.12" pos="1.5 0 0.24" material="stairs"/>
        
        <!-- 平层部分 -->
        <geom name="platform" type="box" size="0.5 3 0.16" pos="1.8 0 0.32" material="stairs"/>
        
        <!-- 下楼梯部分 - 间距缩小为0.3米 -->
        <geom name="step4" type="box" size="0.5 3 0.12" pos="2.1 0 0.24" material="stairs"/>
        <geom name="step5" type="box" size="0.5 3 0.08" pos="2.4 0 0.16" material="stairs"/>
        <geom name="step6" type="box" size="0.5 3 0.04" pos="2.7 0 0.08" material="stairs"/>
    </worldbody>

</mujoco>
