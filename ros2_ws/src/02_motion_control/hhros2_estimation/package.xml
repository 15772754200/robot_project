<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hhros2_estimation</name>
  <version>0.1.0</version>
  <description>
    Floating-base state estimation (02_motion_control). Fuses IMU and leg
    kinematics with foot-contact detection into a base pose/twist estimate.
    Provided as an rclcpp component for zero-copy intra-process composition with
    the controllers and motion cores.
  </description>
  <maintainer email="robotics@example.com">robot_platform maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>hhros2_interfaces</depend>
  <depend>hhros2_log</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
